{
  "$id": "https://openadam.dev/dependency-engine/validate.result.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "ok"
        },
        "kind": {
          "type": "string",
          "const": "validation"
        },
        "valid": {
          "type": "boolean"
        },
        "node_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "relation_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "DUPLICATE_NODE",
                  "DUPLICATE_RELATION",
                  "UNKNOWN_NODE",
                  "DEPENDENCY_CYCLE"
                ]
              },
              "message": {
                "type": "string"
              },
              "nodes": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/DependencyNodeId"
                }
              },
              "relation": {
                "allOf": [
                  {
                    "$ref": "#/definitions/__schema0"
                  }
                ]
              }
            },
            "required": [
              "code",
              "message",
              "nodes"
            ],
            "additionalProperties": false
          }
        },
        "cycles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "component": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/DependencyNodeId"
                }
              },
              "witness": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/DependencyNodeId"
                }
              }
            },
            "required": [
              "component",
              "witness"
            ],
            "additionalProperties": false
          }
        },
        "topological_order": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/DependencyNodeId"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_layers": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/DependencyNodeId"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "normalized_graph": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "const": "agent-deps/v1"
            },
            "nodes": {
              "minItems": 1,
              "maxItems": 5000,
              "type": "array",
              "items": {
                "$ref": "#/definitions/__schema1"
              }
            },
            "requires": {
              "maxItems": 20000,
              "type": "array",
              "items": {
                "$ref": "#/definitions/__schema0"
              }
            }
          },
          "required": [
            "schema",
            "nodes",
            "requires"
          ],
          "additionalProperties": false
        },
        "receipt": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string",
              "const": "dependency-engine"
            },
            "version": {
              "type": "string",
              "const": "0.1.0"
            },
            "operation": {
              "type": "string",
              "enum": [
                "validate",
                "resolve",
                "impact",
                "slice",
                "explain"
              ]
            },
            "graph_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "request_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "result_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "engine",
            "version",
            "operation",
            "graph_hash",
            "request_hash",
            "result_hash"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "kind",
        "valid",
        "node_count",
        "relation_count",
        "issues",
        "cycles",
        "topological_order",
        "execution_layers",
        "normalized_graph",
        "receipt"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "error"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "details": {}
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "error"
      ],
      "additionalProperties": false
    }
  ],
  "definitions": {
    "DependencyNodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "__schema0": {
      "type": "object",
      "properties": {
        "dependent": {
          "$ref": "#/definitions/DependencyNodeId"
        },
        "prerequisite": {
          "$ref": "#/definitions/DependencyNodeId"
        }
      },
      "required": [
        "dependent",
        "prerequisite"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/DependencyNodeId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  }
}
