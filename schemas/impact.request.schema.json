{
  "$id": "https://openadam.dev/dependency-engine/impact.request.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "graph": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "agent-deps/v1"
        },
        "nodes": {
          "minItems": 1,
          "maxItems": 5000,
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema0"
          }
        },
        "requires": {
          "maxItems": 20000,
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema1"
          }
        }
      },
      "required": [
        "schema",
        "nodes",
        "requires"
      ],
      "additionalProperties": false
    },
    "changed": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "$ref": "#/definitions/DependencyNodeId"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 10,
          "maximum": 5000
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 131072
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "graph",
    "changed"
  ],
  "additionalProperties": false,
  "definitions": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/DependencyNodeId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "DependencyNodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "dependent": {
          "$ref": "#/definitions/DependencyNodeId"
        },
        "prerequisite": {
          "$ref": "#/definitions/DependencyNodeId"
        }
      },
      "required": [
        "dependent",
        "prerequisite"
      ],
      "additionalProperties": false
    }
  }
}
