{
  "name": "@openadam/dependency-engine",
  "version": "0.1.1",
  "private": true,
  "description": "Deterministic Dependency Engine for humans and AI agents reasoning over declared graphs.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "openAdam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetracoralla/deterministic-dependency-engine.git"
  },
  "homepage": "https://github.com/tetracoralla/deterministic-dependency-engine#readme",
  "bugs": {
    "url": "https://github.com/tetracoralla/deterministic-dependency-engine/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "dependency-engine": "./dist/adapters/cli.js",
    "dependency-engine-mcp": "./dist/adapters/mcp.js",
    "dependency-engine-http": "./dist/adapters/http-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    ".codex-plugin",
    ".mcp.json",
    "design/deterministic-dependency-engine.png",
    "dist",
    "docs",
    "schemas",
    "skills",
    "ui-dist",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "npm run build:node && npm run build:web",
    "build:node": "tsc -p tsconfig.build.json",
    "build:web": "vite build && node scripts/copy-web-legal.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:generate": "node --import tsx scripts/generate-schemas.ts",
    "schema:check": "node --import tsx scripts/generate-schemas.ts --check",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepack": "npm run build",
    "plugin:check": "node scripts/check-plugin.mjs",
    "runtime:probe": "node scripts/probe-runtime.mjs",
    "check": "npm run typecheck && npm test && npm run schema:check && npm run check:contracts && npm run build && npm run check:release && npm run runtime:probe && npm run plugin:check",
    "start": "node --import tsx src/adapters/cli.ts",
    "start:mcp": "node --import tsx src/adapters/mcp.ts",
    "start:http": "node --import tsx src/adapters/http-server.ts",
    "start:ui": "vite"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "2.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
